{
  "$defs": {
    "TrustedManifestPayload": {
      "additionalProperties": false,
      "properties": {
        "destination_path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Destination Path",
          "type": "string"
        },
        "ownership_mode": {
          "enum": [
            "owned",
            "shared-template",
            "adopted"
          ],
          "title": "Ownership Mode",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "repository",
            "agent",
            "shared-runtime"
          ],
          "title": "Scope",
          "type": "string"
        },
        "semantic_patch_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Patch Id"
        },
        "semantic_patch_mode": {
          "default": "none",
          "enum": [
            "none",
            "apply"
          ],
          "title": "Semantic Patch Mode",
          "type": "string"
        },
        "source_template_path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Source Template Path",
          "type": "string"
        },
        "template_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "template_version",
        "source_template_path",
        "destination_path",
        "ownership_mode",
        "scope",
        "required"
      ],
      "title": "TrustedManifestPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "managed_payloads": {
      "items": {
        "$ref": "#/$defs/TrustedManifestPayload"
      },
      "title": "Managed Payloads",
      "type": "array"
    },
    "manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Manifest Version",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "manifest_id",
    "manifest_version",
    "managed_payloads"
  ],
  "title": "TrustedTemplateManifest",
  "type": "object"
}
