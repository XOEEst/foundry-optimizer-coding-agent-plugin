{
  "$defs": {
    "DecisionPolicy": {
      "additionalProperties": false,
      "properties": {
        "focused_cases_required": {
          "title": "Focused Cases Required",
          "type": "boolean"
        },
        "max_regressions": {
          "title": "Max Regressions",
          "type": "integer"
        },
        "minimum_aggregate_delta": {
          "title": "Minimum Aggregate Delta",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "minimum_aggregate_delta",
        "focused_cases_required",
        "max_regressions"
      ],
      "title": "DecisionPolicy",
      "type": "object"
    },
    "DefaultEvaluatorBundle": {
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "items": {
            "$ref": "#/$defs/ImmutableDatasetReference"
          },
          "title": "Datasets",
          "type": "array"
        },
        "definitions": {
          "items": {
            "$ref": "#/$defs/ImmutableDefinitionReference"
          },
          "title": "Definitions",
          "type": "array"
        },
        "objective": {
          "$ref": "#/$defs/ResolvedWeightedObjective"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "objective",
        "datasets",
        "definitions"
      ],
      "title": "DefaultEvaluatorBundle",
      "type": "object"
    },
    "DeploymentSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "require_aligned_binding": {
          "title": "Require Aligned Binding",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "environment",
        "enabled",
        "require_aligned_binding"
      ],
      "title": "DeploymentSettings",
      "type": "object"
    },
    "EvaluatorNormalization": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pass_fail",
            "scalar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Max"
        },
        "source_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Min"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EvaluatorNormalization",
      "type": "object"
    },
    "EvaluatorReference": {
      "additionalProperties": false,
      "properties": {
        "evaluator_id": {
          "anyOf": [
            {
              "pattern": "^azureai://accounts/[^/]+/projects/[^/]+/evaluators/[^/]+/versions/[^/]+$",
              "type": "string"
            },
            {
              "pattern": "^azureai://built-in/evaluators/[^/]+$",
              "type": "string"
            }
          ],
          "title": "Evaluator Id"
        },
        "provenance": {
          "enum": [
            "reused_existing",
            "auto_generated_unreviewed",
            "issue_supplied_existing"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "evaluator_id",
        "provenance"
      ],
      "title": "EvaluatorReference",
      "type": "object"
    },
    "FoundryProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "account_resource_id": {
          "title": "Account Resource Id",
          "type": "string"
        },
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "expected_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "model_deployment_aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Model Deployment Aliases",
          "type": "array"
        },
        "project_endpoint": {
          "title": "Project Endpoint",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "project_endpoint",
        "account_resource_id",
        "agent_name"
      ],
      "title": "FoundryProjectSettings",
      "type": "object"
    },
    "HardGuardrail": {
      "additionalProperties": false,
      "properties": {
        "evaluator_name": {
          "title": "Evaluator Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "required_pass_rate": {
          "title": "Required Pass Rate",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "evaluator_name",
        "required_pass_rate"
      ],
      "title": "HardGuardrail",
      "type": "object"
    },
    "ImmutableDatasetReference": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "pattern": "^azureai://accounts/[^/]+/projects/[^/]+/data/[^/]+/versions/[^/]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "ImmutableDatasetReference",
      "type": "object"
    },
    "ImmutableDefinitionReference": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|azureai://accounts/[^/]+/projects/[^/]+/evaluationDefinitions/[^/]+/versions/[^/]+)$",
          "title": "Definition Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "definition_id"
      ],
      "title": "ImmutableDefinitionReference",
      "type": "object"
    },
    "ResolvedEvaluator": {
      "additionalProperties": false,
      "properties": {
        "normalization": {
          "$ref": "#/$defs/EvaluatorNormalization"
        },
        "reference": {
          "$ref": "#/$defs/EvaluatorReference"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "reference",
        "normalization",
        "weight"
      ],
      "title": "ResolvedEvaluator",
      "type": "object"
    },
    "ResolvedWeightedObjective": {
      "additionalProperties": false,
      "properties": {
        "evaluators": {
          "items": {
            "$ref": "#/$defs/ResolvedEvaluator"
          },
          "title": "Evaluators",
          "type": "array"
        },
        "objective_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Objective Hash",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "evaluators",
        "objective_hash"
      ],
      "title": "ResolvedWeightedObjective",
      "type": "object"
    },
    "RuntimeProtocolSettings": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "dependency_resolution": {
          "title": "Dependency Resolution",
          "type": "string"
        },
        "entrypoint": {
          "items": {
            "type": "string"
          },
          "title": "Entrypoint",
          "type": "array"
        },
        "kind": {
          "const": "hosted",
          "title": "Kind",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "model_environment_variable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Environment Variable"
        },
        "protocol_name": {
          "title": "Protocol Name",
          "type": "string"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "runtime",
        "entrypoint",
        "dependency_resolution",
        "protocol_name",
        "protocol_version"
      ],
      "title": "RuntimeProtocolSettings",
      "type": "object"
    },
    "SharedSourceRelation": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Agent Id",
          "type": "string"
        },
        "relation": {
          "const": "shared-source",
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "relation"
      ],
      "title": "SharedSourceRelation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_models": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Models",
      "type": "array"
    },
    "baseline_model": {
      "title": "Baseline Model",
      "type": "string"
    },
    "decision_policy": {
      "$ref": "#/$defs/DecisionPolicy"
    },
    "default_evaluator_bundle": {
      "$ref": "#/$defs/DefaultEvaluatorBundle"
    },
    "deployment": {
      "$ref": "#/$defs/DeploymentSettings"
    },
    "development_dataset": {
      "$ref": "#/$defs/ImmutableDatasetReference"
    },
    "development_definition": {
      "$ref": "#/$defs/ImmutableDefinitionReference"
    },
    "editable_paths": {
      "items": {
        "type": "string"
      },
      "title": "Editable Paths",
      "type": "array"
    },
    "foundry_project": {
      "$ref": "#/$defs/FoundryProjectSettings"
    },
    "hard_guardrails": {
      "items": {
        "$ref": "#/$defs/HardGuardrail"
      },
      "title": "Hard Guardrails",
      "type": "array"
    },
    "max_candidates": {
      "title": "Max Candidates",
      "type": "integer"
    },
    "max_issue_evaluators": {
      "default": 8,
      "title": "Max Issue Evaluators",
      "type": "integer"
    },
    "min_candidates": {
      "title": "Min Candidates",
      "type": "integer"
    },
    "package_root": {
      "title": "Package Root",
      "type": "string"
    },
    "primary_metric": {
      "title": "Primary Metric",
      "type": "string"
    },
    "repo_agent_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Repo Agent Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeProtocolSettings"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shared_source_relations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SharedSourceRelation"
      },
      "title": "Shared Source Relations",
      "type": "array"
    },
    "source_root": {
      "title": "Source Root",
      "type": "string"
    },
    "validating_dataset": {
      "$ref": "#/$defs/ImmutableDatasetReference"
    },
    "validating_definition": {
      "$ref": "#/$defs/ImmutableDefinitionReference"
    }
  },
  "required": [
    "repo_agent_id",
    "source_root",
    "package_root",
    "editable_paths",
    "runtime",
    "foundry_project",
    "baseline_model",
    "allowed_models",
    "min_candidates",
    "max_candidates",
    "primary_metric",
    "decision_policy",
    "development_dataset",
    "validating_dataset",
    "development_definition",
    "validating_definition",
    "default_evaluator_bundle",
    "hard_guardrails",
    "deployment"
  ],
  "title": "BootstrapSidecar",
  "type": "object"
}
