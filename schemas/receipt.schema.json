{
  "$defs": {
    "FingerprintRecord": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "label",
        "sha256"
      ],
      "title": "FingerprintRecord",
      "type": "object"
    },
    "RedactedStatusInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "RedactedStatusInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adopted_actions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Adopted Actions",
      "type": "array"
    },
    "after_fingerprints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FingerprintRecord"
      },
      "title": "After Fingerprints",
      "type": "array"
    },
    "before_fingerprints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FingerprintRecord"
      },
      "title": "Before Fingerprints",
      "type": "array"
    },
    "changed_actions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Changed Actions",
      "type": "array"
    },
    "compensation_required_actions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Compensation Required Actions",
      "type": "array"
    },
    "created_actions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Created Actions",
      "type": "array"
    },
    "error_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/RedactedStatusInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "receipt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Hash",
      "type": "string"
    },
    "repository_identity": {
      "title": "Repository Identity",
      "type": "string"
    },
    "resume_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/RedactedStatusInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "skipped_actions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Skipped Actions",
      "type": "array"
    }
  },
  "required": [
    "operation_id",
    "runtime_sha256",
    "repository_identity",
    "plan_hash",
    "receipt_hash"
  ],
  "title": "BootstrapReceipt",
  "type": "object"
}
