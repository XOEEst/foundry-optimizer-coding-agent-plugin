{
  "$defs": {
    "DistributionSettings": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "deployment_client_id_variable": {
          "title": "Deployment Client Id Variable",
          "type": "string"
        },
        "deployment_environment": {
          "title": "Deployment Environment",
          "type": "string"
        },
        "optimizer_client_id_variable": {
          "title": "Optimizer Client Id Variable",
          "type": "string"
        },
        "optimizer_environment": {
          "title": "Optimizer Environment",
          "type": "string"
        },
        "pin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pin"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
