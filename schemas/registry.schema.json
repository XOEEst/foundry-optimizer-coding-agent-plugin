      "title": "DistributionSettings",
      "type": "object"
    },
    "ExplicitAgentEntry": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Agent Id",
          "type": "string"
        },
        "config_path": {
          "title": "Config Path",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "root",
        "config_path"
      ],
      "title": "ExplicitAgentEntry",
      "type": "object"
    },
    "IdentitySettings": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "azure_subscription",
