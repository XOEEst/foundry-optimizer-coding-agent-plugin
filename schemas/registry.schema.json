    "distribution": {
      "$ref": "#/$defs/DistributionSettings"
    },
    "identity": {
      "$ref": "#/$defs/IdentitySettings"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
