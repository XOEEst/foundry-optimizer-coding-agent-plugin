{
  "$defs": {
    "ActivationPlan": {
      "additionalProperties": false,
      "properties": {
        "draft_agent_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Draft Agent Name",
          "type": "string"
        },
        "draft_agent_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Draft Agent Version",
          "type": "string"
        },
        "model_deployment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Model Deployment",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "draft_agent_name",
        "draft_agent_version",
        "model_deployment"
      ],
      "title": "ActivationPlan",
      "type": "object"
    },
    "DatasetPlan": {
      "additionalProperties": false,
      "description": "Deterministic dataset naming, reviewed reuse candidates, and the generation job id.",
      "properties": {
        "agent_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Agent Name",
          "type": "string"
        },
        "agent_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Agent Version",
          "type": "string"
        },
        "connection_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Name"
        },
        "dataset_type": {
          "default": "uri_file",
          "enum": [
            "uri_file",
            "uri_folder"
          ],
          "title": "Dataset Type",
          "type": "string"
        },
        "generation_job_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Generation Job Id",
          "type": "string"
        },
        "generation_kind": {
          "enum": [
            "dataset_trace",
            "dataset_synthetic"
          ],
          "title": "Generation Kind",
          "type": "string"
        },
        "generation_model_deployment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Generation Model Deployment",
          "type": "string"
        },
        "requested_development_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Development Name",
          "type": "string"
        },
        "requested_validating_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Validating Name",
          "type": "string"
        },
        "requested_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Version",
          "type": "string"
        },
        "reuse_development_dataset_id": {
          "anyOf": [
            {
              "pattern": "^azureai://accounts/[^/]+/projects/[^/]+/data/[^/]+/versions/[^/]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reuse Development Dataset Id"
        },
        "reuse_validating_dataset_id": {
          "anyOf": [
            {
              "pattern": "^azureai://accounts/[^/]+/projects/[^/]+/data/[^/]+/versions/[^/]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reuse Validating Dataset Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "requested_development_name",
        "requested_validating_name",
        "requested_version",
        "generation_kind",
        "generation_job_id",
        "source_fingerprint",
        "agent_name",
        "agent_version",
        "generation_model_deployment"
      ],
      "title": "DatasetPlan",
      "type": "object"
    },
    "DecisionPolicy": {
      "additionalProperties": false,
      "properties": {
        "focused_cases_required": {
          "title": "Focused Cases Required",
          "type": "boolean"
        },
        "max_regressions": {
          "title": "Max Regressions",
          "type": "integer"
        },
        "minimum_aggregate_delta": {
          "title": "Minimum Aggregate Delta",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "minimum_aggregate_delta",
        "focused_cases_required",
        "max_regressions"
      ],
      "title": "DecisionPolicy",
      "type": "object"
    },
    "DefinitionPlan": {
      "additionalProperties": false,
      "properties": {
        "model_deployment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Model Deployment",
          "type": "string"
        },
        "requested_development_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Development Name",
          "type": "string"
        },
        "requested_validating_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Validating Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "requested_development_name",
        "requested_validating_name",
        "model_deployment"
      ],
      "title": "DefinitionPlan",
      "type": "object"
    },
    "DeploymentSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "require_aligned_binding": {
          "title": "Require Aligned Binding",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "environment",
        "enabled",
        "require_aligned_binding"
      ],
      "title": "DeploymentSettings",
      "type": "object"
    },
    "EvaluatorNormalization": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pass_fail",
            "scalar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Max"
        },
        "source_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Min"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EvaluatorNormalization",
      "type": "object"
    },
    "EvaluatorPlan": {
      "additionalProperties": false,
      "description": "Deterministic evaluator naming plus the required built-in safety bundle.",
      "properties": {
        "generation_job_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Job Id"
        },
        "objective_normalization": {
          "$ref": "#/$defs/EvaluatorNormalization"
        },
        "objective_weight": {
          "default": 1.0,
          "title": "Objective Weight",
          "type": "number"
        },
        "requested_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Name",
          "type": "string"
        },
        "requested_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Requested Version",
          "type": "string"
        },
        "required_safety_evaluators": {
          "default": [
            "violence",
            "sexual",
            "self_harm",
            "hate_unfairness",
            "indirect_attack"
          ],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Required Safety Evaluators",
          "type": "array"
        },
        "reuse_evaluator_id": {
          "anyOf": [
            {
              "pattern": "^azureai://accounts/[^/]+/projects/[^/]+/evaluators/[^/]+/versions/[^/]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reuse Evaluator Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "requested_name",
        "requested_version",
        "objective_normalization"
      ],
      "title": "EvaluatorPlan",
      "type": "object"
    },
    "FoundryProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "account_resource_id": {
          "title": "Account Resource Id",
          "type": "string"
        },
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "expected_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "model_deployment_aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Model Deployment Aliases",
          "type": "array"
        },
        "project_endpoint": {
          "title": "Project Endpoint",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "project_endpoint",
        "account_resource_id",
        "agent_name"
      ],
      "title": "FoundryProjectSettings",
      "type": "object"
    },
    "HardGuardrail": {
      "additionalProperties": false,
      "properties": {
        "evaluator_name": {
          "title": "Evaluator Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "required_pass_rate": {
          "title": "Required Pass Rate",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "evaluator_name",
        "required_pass_rate"
      ],
      "title": "HardGuardrail",
      "type": "object"
    },
    "OnboardingBounds": {
      "additionalProperties": false,
      "description": "Reviewed, fail-closed bounds every dynamic onboarding output must satisfy.",
      "properties": {
        "allowed_dataset_types": {
          "default": [
            "uri_file"
          ],
          "items": {
            "enum": [
              "uri_file",
              "uri_folder"
            ],
            "type": "string"
          },
          "title": "Allowed Dataset Types",
          "type": "array"
        },
        "allowed_provenance": {
          "default": [
            "reused_existing",
            "auto_generated_unreviewed"
          ],
          "items": {
            "enum": [
              "reused_existing",
              "auto_generated_unreviewed",
              "issue_supplied_existing"
            ],
            "type": "string"
          },
          "title": "Allowed Provenance",
          "type": "array"
        },
        "maximum_evaluators": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Maximum Evaluators",
          "type": "integer"
        },
        "maximum_generated_sample_count": {
          "default": 200,
          "maximum": 10000,
          "minimum": 15,
          "title": "Maximum Generated Sample Count",
          "type": "integer"
        },
        "minimum_development_cases": {
          "default": 10,
          "maximum": 1000,
          "minimum": 10,
          "title": "Minimum Development Cases",
          "type": "integer"
        },
        "minimum_validating_cases": {
          "default": 5,
          "maximum": 1000,
          "minimum": 5,
          "title": "Minimum Validating Cases",
          "type": "integer"
        },
        "require_measurable_headroom": {
          "default": true,
          "title": "Require Measurable Headroom",
          "type": "boolean"
        },
        "required_safety_evaluators": {
          "default": [
            "violence",
            "sexual",
            "self_harm",
            "hate_unfairness",
            "indirect_attack"
          ],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Required Safety Evaluators",
          "type": "array"
        },
        "required_safety_pass_rate": {
          "default": 1.0,
          "title": "Required Safety Pass Rate",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_sample_count": {
          "default": 30,
          "maximum": 1000,
          "minimum": 15,
          "title": "Target Sample Count",
          "type": "integer"
        },
        "telemetry_minimum_samples": {
          "default": 15,
          "maximum": 1000,
          "minimum": 15,
          "title": "Telemetry Minimum Samples",
          "type": "integer"
        }
      },
      "title": "OnboardingBounds",
      "type": "object"
    },
    "ReplacementLineage": {
      "additionalProperties": false,
      "description": "Previous immutable contract retained until an explicit replacement activates.",
      "properties": {
        "previous_bundle_objective_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Previous Bundle Objective Hash",
          "type": "string"
        },
        "previous_development_definition_id": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|azureai://accounts/[^/]+/projects/[^/]+/evaluationDefinitions/[^/]+/versions/[^/]+)$",
          "title": "Previous Development Definition Id",
          "type": "string"
        },
        "previous_sidecar_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Previous Sidecar Sha256",
          "type": "string"
        },
        "previous_validating_definition_id": {
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|azureai://accounts/[^/]+/projects/[^/]+/evaluationDefinitions/[^/]+/versions/[^/]+)$",
          "title": "Previous Validating Definition Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "previous_bundle_objective_hash",
        "previous_sidecar_sha256",
        "previous_development_definition_id",
        "previous_validating_definition_id"
      ],
      "title": "ReplacementLineage",
      "type": "object"
    },
    "RuntimeProtocolSettings": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "dependency_resolution": {
          "title": "Dependency Resolution",
          "type": "string"
        },
        "entrypoint": {
          "items": {
            "type": "string"
          },
          "title": "Entrypoint",
          "type": "array"
        },
        "kind": {
          "const": "hosted",
          "title": "Kind",
          "type": "string"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "model_environment_variable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Environment Variable"
        },
        "protocol_name": {
          "title": "Protocol Name",
          "type": "string"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "runtime",
        "entrypoint",
        "dependency_resolution",
        "protocol_name",
        "protocol_version"
      ],
      "title": "RuntimeProtocolSettings",
      "type": "object"
    },
    "SidecarPolicy": {
      "additionalProperties": false,
      "description": "Static, reviewed sidecar content; immutable ids and lineage are filled from the receipt.",
      "properties": {
        "allowed_models": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Allowed Models",
          "type": "array"
        },
        "baseline_model": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Baseline Model",
          "type": "string"
        },
        "decision_policy": {
          "$ref": "#/$defs/DecisionPolicy"
        },
        "deployment": {
          "$ref": "#/$defs/DeploymentSettings"
        },
        "editable_paths": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "title": "Editable Paths",
          "type": "array"
        },
        "foundry_project": {
          "$ref": "#/$defs/FoundryProjectSettings"
        },
        "hard_guardrails": {
          "items": {
            "$ref": "#/$defs/HardGuardrail"
          },
          "title": "Hard Guardrails",
          "type": "array"
        },
        "max_candidates": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_issue_evaluators": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Issue Evaluators",
          "type": "integer"
        },
        "min_candidates": {
          "maximum": 64,
          "minimum": 1,
          "title": "Min Candidates",
          "type": "integer"
        },
        "package_root": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Package Root",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "primary_metric": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Primary Metric",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeProtocolSettings"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_root": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Source Root",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source_root",
        "package_root",
        "editable_paths",
        "runtime",
        "foundry_project",
        "baseline_model",
        "allowed_models",
        "min_candidates",
        "max_candidates",
        "primary_metric",
        "decision_policy",
        "hard_guardrails",
        "deployment"
      ],
      "title": "SidecarPolicy",
      "type": "object"
    },
    "TelemetryProbe": {
      "additionalProperties": false,
      "description": "Reviewed trace-availability evidence: counts and a window identifier only.",
      "properties": {
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "prerequisites_available": {
          "title": "Prerequisites Available",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "telemetry_window": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+$",
          "title": "Telemetry Window",
          "type": "string"
        },
        "useful_sample_count": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Useful Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "prerequisites_available",
        "useful_sample_count",
        "telemetry_window",
        "eligible"
      ],
      "title": "TelemetryProbe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One approval-bound composite onboarding request for one selected agent.",
  "properties": {
    "activation_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivationPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "binding_classification": {
      "enum": [
        "bound-aligned",
        "bound-diverged",
        "bound-unknown",
        "ready-unbound",
        "not-ready"
      ],
      "title": "Binding Classification",
      "type": "string"
    },
    "bounds": {
      "$ref": "#/$defs/OnboardingBounds",
      "default": {
        "allowed_dataset_types": [
          "uri_file"
        ],
        "allowed_provenance": [
          "reused_existing",
          "auto_generated_unreviewed"
        ],
