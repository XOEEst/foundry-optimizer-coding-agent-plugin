          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fic Resource Id"
        },
        "foundry_resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foundry Resource Id"
        },
        "rbac_resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rbac Resource Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "IdentityOwnershipLedgerEntry",
      "type": "object"
    },
    "ManagedFileEntry": {
      "additionalProperties": false,
      "properties": {
        "applied_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Applied Sha256",
          "type": "string"
        },
        "ownership_mode": {
          "enum": [
            "owned",
            "shared-template",
            "adopted"
          ],
          "title": "Ownership Mode",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "semantic_patch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Patch Id"
        },
        "template_base_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Template Base Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "ownership_mode",
        "template_base_sha256",
        "applied_sha256"
      ],
      "title": "ManagedFileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "channel": {
      "title": "Channel",
      "type": "string"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "exact_revision": {
      "title": "Exact Revision",
      "type": "string"
    },
    "github_environments": {
