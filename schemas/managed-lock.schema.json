      "type": "array"
    },
    "identity_ownership": {
      "items": {
        "$ref": "#/$defs/IdentityOwnershipLedgerEntry"
      },
      "title": "Identity Ownership",
      "type": "array"
    },
    "last_activation": {
      "$ref": "#/$defs/ActivationOutcomeRecord"
    },
    "managed_files": {
      "items": {
        "$ref": "#/$defs/ManagedFileEntry"
      },
      "title": "Managed Files",
      "type": "array"
    },
    "runtime_repository": {
      "title": "Runtime Repository",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sidecar_paths": {
      "items": {
