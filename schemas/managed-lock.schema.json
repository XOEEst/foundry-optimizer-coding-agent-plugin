  "required": [
    "engine",
    "runtime_repository",
    "channel",
    "exact_revision",
    "managed_files",
    "github_environments",
    "identity_ownership",
    "sidecar_paths",
    "last_activation"
  ],
  "title": "BootstrapLock",
  "type": "object"
}
