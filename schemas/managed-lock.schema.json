{
  "$defs": {
    "ActivationOutcomeRecord": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "compensation_required",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "ActivationOutcomeRecord",
      "type": "object"
    },
    "GitHubEnvironmentLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "variable_names": {
          "items": {
            "type": "string"
          },
          "title": "Variable Names",
          "type": "array"
        }
      },
      "required": [
        "environment",
        "variable_names"
      ],
      "title": "GitHubEnvironmentLedgerEntry",
      "type": "object"
    },
    "IdentityOwnershipLedgerEntry": {
      "additionalProperties": false,
      "properties": {
