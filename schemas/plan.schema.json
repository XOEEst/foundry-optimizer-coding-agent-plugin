{
  "$defs": {
    "BootstrapAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "phase": {
          "enum": [
            "repository",
            "github",
            "azure",
            "evaluations"
          ],
          "title": "Phase",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "planned",
            "applying",
            "verifying",
            "completed",
            "failed",
            "compensation_required"
          ],
          "title": "Stage",
          "type": "string"
        },
        "target_agent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Agent Id"
        },
        "template_payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplatePayloadSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action_id",
        "phase",
        "stage",
        "kind"
      ],
      "title": "BootstrapAction",
      "type": "object"
    },
    "SemanticPatchSpec": {
      "additionalProperties": false,
      "properties": {
        "match_text": {
          "title": "Match Text",
          "type": "string"
        },
        "operation": {
          "enum": [
            "replace",
            "insert_before",
            "insert_after",
            "delete"
          ],
          "title": "Operation",
          "type": "string"
        },
        "replacement_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Text"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_path": {
          "title": "Target Path",
          "type": "string"
        }
      },
      "required": [
        "target_path",
        "operation",
        "match_text"
      ],
      "title": "SemanticPatchSpec",
      "type": "object"
    },
    "TemplatePayloadSpec": {
      "additionalProperties": false,
      "properties": {
        "destination_path": {
          "title": "Destination Path",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "semantic_patches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SemanticPatchSpec"
          },
          "title": "Semantic Patches",
          "type": "array"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "destination_path",
        "payload"
      ],
      "title": "TemplatePayloadSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/BootstrapAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "repository_identity": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository Identity",
      "type": "string"
    },
    "runtime_commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Runtime Commit",
      "type": "string"
    },
    "runtime_repository": {
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$",
      "title": "Runtime Repository",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "operation_id",
    "runtime_repository",
    "runtime_commit",
    "repository_identity",
    "actions",
    "plan_hash"
  ],
  "title": "BootstrapPlan",
  "type": "object"
}
